# Database Configuration
DB_USER=treinawebusr
DB_PASSWORD=treinawebpwd
DB_DATABASE=treinaweb
DB_PORT=3306
DB_ROOT_PASSWORD_FILE_PATH=./db/pwd.txt

# Database Connection Pool Tuning
# Max open connections to prevent exceeding database limit (Default: 100)
DB_MAX_OPEN_CONNS=100
# Max idle connections kept in the pool to avoid constant connection churn (Default: 50)
DB_MAX_IDLE_CONNS=50
# Max duration a connection can be reused (e.g., 5m, 1h) (Default: 5m)
DB_CONN_MAX_LIFETIME=5m
# Max duration a connection can remain idle before being closed (e.g., 2m, 10m) (Default: 2m)
DB_CONN_MAX_IDLE_TIME=2m

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Spring Boot Admin Client/Server Credentials
SPRING_BOOT_ADMIN_USERNAME=admin
SPRING_BOOT_ADMIN_PASSWORD=admin

# phpMyAdmin Configuration
PMA_PORT=9090

# RSA Keys configuration (can point to absolute file path, e.g., file:/path/to/private-key.pem)
RSA_PRIVATE_KEY_PATH=classpath:certs/private-key.pem
RSA_PUBLIC_KEY_PATH=classpath:certs/public-key.pem

# Jmeter parameters
JMETER_SERVER=app
JMETER_PORT=8080
JMETER_PROTOCOL=http
JMETER_THREADS=10
JMETER_RAMPUP=2
JMETER_DURATION=3
